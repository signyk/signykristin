---
interface Props {
  title: string;
  subtitle?: string;
  date?: string;
  details?: string[];
}

const { title, subtitle, date, details = [] } = Astro.props;
---

<article>
  <div class="head">
    <h3>{title}</h3>
    {date && <span class="date">{date}</span>}
  </div>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  {details.length > 0 && (
    <ul class="details">
      {details.map((detail) => (
        <li>{detail}</li>
      ))}
    </ul>
  )}
</article>

<style>
  article {
    break-inside: avoid;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  h3 {
    font-size: var(--text-base);
  }

  .date,
  .subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .date {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .details {
    margin-top: var(--space-1);
    padding-left: var(--space-4);
    list-style: '–  ';
    font-size: var(--text-sm);
  }
</style>
