---
import { Icon } from 'astro-icon/components';
---

<button type="button" class="theme-toggle" aria-label="Toggle dark mode" aria-pressed="false">
  <Icon name="lucide:moon" class="moon" aria-hidden="true" />
  <Icon name="lucide:sun" class="sun" aria-hidden="true" />
</button>

<script>
  const root = document.documentElement;

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));

    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      button.setAttribute('aria-pressed', String(theme === 'dark'));
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color var(--transition),
      background-color var(--transition);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .theme-toggle svg {
    width: 1rem;
    height: 1rem;
  }

  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: block;
  }
</style>
