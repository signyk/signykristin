---
import type { CollectionEntry } from 'astro:content';
import { externalAttrs } from '../lib/links';
import LinkList from './LinkList.astro';
import NewTabHint from './NewTabHint.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { title, description, links, repo, tags } = Astro.props.project.data;
const primary = links[0]?.href ?? repo;
---

<article>
  <div class="row">
    <h3>
      {primary ? (
        <a href={primary} {...externalAttrs(primary)}>
          {title}
          <NewTabHint href={primary} />
        </a>
      ) : (
        title
      )}
    </h3>
    {tags.length > 0 && <p class="tags">{tags.join(', ')}</p>}
  </div>
  <p class="description">{description}</p>
  <LinkList
    links={{ ...Object.fromEntries(links.map(({ label, href }) => [label, href])), Code: repo }}
  />
</article>

<style>
  article {
    display: grid;
    gap: var(--space-1);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  h3 a {
    text-decoration: none;
  }

  .tags {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .description {
    margin-bottom: var(--space-1);
  }
</style>
