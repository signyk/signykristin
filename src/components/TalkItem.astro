---
import type { CollectionEntry } from 'astro:content';
import LinkList from './LinkList.astro';

interface Props {
  talk: CollectionEntry<'talks'>;
}

const { title, event, location, date, links } = Astro.props.talk.data;
const formatted = date.toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article>
  <div class="row">
    <h3>{title}</h3>
    <time datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
  </div>
  <p>
    {event}, {location}
  </p>
  <LinkList links={{ Slides: links.slides, Video: links.video }} />
</article>

<style>
  article {
    display: grid;
    gap: var(--space-1);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  time {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
