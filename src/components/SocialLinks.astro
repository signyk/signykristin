---
import { site } from '../data/site';
import { externalAttrs } from '../lib/links';
import NewTabHint from './NewTabHint.astro';

interface Props {
  /** Leave out the email link where it already has its own button. */
  email?: boolean;
}

const { email = true } = Astro.props;
const links = [
  ...(email ? [{ label: 'Email', href: `mailto:${site.email}` }] : []),
  ...site.socials,
];
---

<ul class="social" role="list">
  {links.map(({ label, href }) => (
    <li>
      <a href={href} {...externalAttrs(href)}>
        {label}
        <NewTabHint href={href} />
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-6);
  }
</style>
