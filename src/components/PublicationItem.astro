---
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';
import LinkList from './LinkList.astro';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { title, authors, venue, year, links, bibtex } = Astro.props.publication.data;
const isMe = (author: string) => site.authorNames.includes(author);
---

<article>
  <div class="row">
    <h3>{title}</h3>
    <span class="year">{year}</span>
  </div>
  <p class="authors">
    {authors.map((author, i) => (
      <>
        {isMe(author) ? <strong>{author}</strong> : author}
        {i < authors.length - 1 && ', '}
      </>
    ))}
  </p>
  <p class="venue">
    <em>{venue}</em>
  </p>
  <div class="actions">
    <LinkList links={{ PDF: links.pdf, arXiv: links.arxiv, DOI: links.doi, Code: links.code }} />
    {bibtex && (
      <details>
        <summary>BibTeX</summary>
        <pre>{bibtex.trim()}</pre>
      </details>
    )}
  </div>
</article>

<style>
  article {
    display: grid;
    gap: var(--space-1);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .year {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .authors,
  .venue {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .authors strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-1);
  }

  details {
    font-size: var(--text-sm);
  }

  summary {
    color: var(--color-muted);
    cursor: pointer;
  }

  details[open] {
    flex-basis: 100%;
  }

  pre {
    margin-top: var(--space-2);
    padding: var(--space-4);
    overflow-x: auto;
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
